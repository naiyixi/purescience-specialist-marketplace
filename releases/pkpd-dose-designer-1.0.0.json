      "uncompressed_bytes": 5325
    },
    {
      "id": "pkpd-modeling",
      "name": "pkpd-modeling",
      "display_name": "pkpd-modeling",
      "description": "设计与执行药代动力学/药效学建模任务：非房室分析（NCA）、房室与群体 PK/PD、协变量筛选、暴露-反应/剂量探索、转化缩放与模型验证。当拿到浓度-时间数据要做 NCA 或建模、需要设计群体 PK 分析（结构模型/随机效应/协变量）、评估暴露-反应关系以支持剂量选择、或审计 PK/PD 分析的单位/模型/验证是否可靠时使用。不做个体化给药建议（不输出个体处方剂量）；单位与量纲错误是本领域最高频事故，全程联动 uncertainty-units-audit；临床前→临床转化需用户明确数据范围。",
      "path": "skills/pkpd-modeling",
